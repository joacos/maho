// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// SERVICES (Individual Sessions & Group Workshops)
// ============================================

enum ServiceType {
  INDIVIDUAL
  WORKSHOP
}

model Service {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  description String?
  type        ServiceType
  duration    Int         // Duration in minutes
  price       Decimal     @db.Decimal(10, 2)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  timeSlots   TimeSlot[]
  workshops   Workshop[]
  appointments Appointment[]

  @@index([type])
  @@index([isActive])
}

// ============================================
// AVAILABILITY / TIME SLOTS
// ============================================

model Availability {
  id         String   @id @default(uuid())
  dayOfWeek  Int      // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime  String   // "09:00" (HH:mm format)
  endTime    String   // "17:00"
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([dayOfWeek, startTime, endTime])
}

model AvailabilityException {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  startTime String?  // null = entire day blocked
  endTime   String?
  isBlocked Boolean  @default(true) // true=unavailable, false=extra availability
  reason    String?
  createdAt DateTime @default(now())

  @@index([date])
}

model TimeSlot {
  id          String    @id @default(uuid())
  serviceId   String
  date        DateTime  @db.Date
  startTime   DateTime
  endTime     DateTime
  isBooked    Boolean   @default(false)
  version     Int       @default(0)  // For optimistic concurrency control
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  appointment Appointment?

  @@index([serviceId, date])
  @@index([date, isBooked])
  @@index([startTime, endTime])
}

// ============================================
// WORKSHOPS (Group Sessions with Capacity)
// ============================================

model Workshop {
  id              String    @id @default(uuid())
  serviceId       String
  title           String
  description     String?
  date            DateTime  @db.Date
  startTime       DateTime
  endTime         DateTime
  maxCapacity     Int
  currentBookings Int       @default(0)
  version         Int       @default(0)  // For optimistic concurrency
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  service         Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@index([date])
  @@index([serviceId])
  @@index([isActive, date])
}

// ============================================
// APPOINTMENTS (with race condition prevention)
// ============================================

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Appointment {
  id          String            @id @default(uuid())
  serviceId   String
  timeSlotId  String?           @unique  // For individual sessions
  workshopId  String?           // For workshop bookings
  clientName  String
  clientEmail String
  clientPhone String?
  notes       String?
  status      AppointmentStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  service     Service   @relation(fields: [serviceId], references: [id])
  timeSlot    TimeSlot? @relation(fields: [timeSlotId], references: [id])
  workshop    Workshop? @relation(fields: [workshopId], references: [id])

  @@index([clientEmail])
  @@index([status])
  @@index([createdAt])
  @@index([workshopId])
}

// ============================================
// LEADS / CRM
// ============================================

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  CONVERTED
  LOST
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  GOOGLE
  OTHER
}

model Lead {
  id         String     @id @default(uuid())
  name       String
  email      String     @unique
  phone      String?
  company    String?
  source     LeadSource @default(WEBSITE)
  status     LeadStatus @default(NEW)
  origin     String     @default("formulario_contacto") // origin: "formulario_contacto", "agendamiento_incompleto", "cita_confirmada"
  notes      String?
  createdAt  DateTime   @db.Timestamptz
  updatedAt  DateTime   @db.Timestamptz @updatedAt

  interactions LeadInteraction[]

  @@index([status])
  @@index([source])
  @@index([createdAt])
}

model LeadInteraction {
  id        String   @id @default(uuid())
  leadId    String
  type      String   // "email", "call", "meeting", "note"
  content   String
  createdAt DateTime @default(now())

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

// ============================================
// NEWS / BLOG POSTS
// ============================================

model Post {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String
  excerpt     String?
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  authorName  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tags        PostTag[]

  @@index([published, publishedAt])
  @@index([slug])
}

model Tag {
  id    String    @id @default(uuid())
  name  String    @unique
  slug  String    @unique
  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}
